###################################################
# Variables Globales
###################################################
client      = "dtl"
project     = "vin"
environment = "dev"
region      = "us-east-1"
profile     = "pra_idp_dev"

# Etiquetas comunes para todos los recursos (aplicadas a nivel de provider)
common_tags = {
  environment  = "dev"
  project-name = "Modulos Referencia"
  cost-center  = "CC-12345"
  owner        = "cloudops@pragma.com.co"
  area         = "CloudOps"
  provisioned  = "terraform"
  datatype     = "interno"
}

# Topic SNS para notificaciones (vacío = no inyectar acciones).
sns_topic_name = ""

###################################################
# Configuración de Alarmas — ejemplo EC2 (CPU + memoria CWAgent)
###################################################
alarm_config = {
  "ec2-web01-high-cpu" = {
    alarm_description   = "CPU > 85% en instancia web-01"
    comparison_operator = "GreaterThanThreshold"
    evaluation_periods  = 2
    threshold           = 85
    metric_name         = "CPUUtilization"
    namespace           = "AWS/EC2"
    period              = 300
    statistic           = "Average"
    datapoints_to_alarm = 2
    treat_missing_data  = "notBreaching"
    dimensions = {
      InstanceId = "i-0123456789abcdef0"
    }
    additional_tags = {
      Criticality = "High"
      Server      = "web-01"
    }
  }

  "ec2-web01-high-memory" = {
    alarm_description   = "Memoria > 90% en instancia web-01 (CWAgent)"
    comparison_operator = "GreaterThanThreshold"
    evaluation_periods  = 3
    threshold           = 90
    metric_name         = "mem_used_percent"
    namespace           = "CWAgent"
    period              = 300
    statistic           = "Average"
    treat_missing_data  = "notBreaching"
    dimensions = {
      InstanceId = "i-0123456789abcdef0"
    }
  }
}
